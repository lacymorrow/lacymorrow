{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "cal.lacymorrow.com"
        }
      ],
      "destination": "https://cal.com/lacymorrow/30min",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "resume.lacymorrow.com"
        }
      ],
      "destination": "https://lacymorrow.com/about/resume",
      "permanent": true
    },
    {
      "source": "/resume",
      "destination": "/about/resume",
      "permanent": true
    }
  ]
}
